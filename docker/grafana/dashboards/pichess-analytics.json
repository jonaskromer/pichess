      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "White win-rate by opening family",
      "description": "Share of games won by White within each opening family (winner=White \u00f7 all in family).",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (family) (pichess_family_result_total{winner=\"White\"}) / clamp_min(sum by (family) (pichess_family_result_total),1)",
          "legendFormat": "{{family}}",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "valueMode": "text",
        "minVizWidth": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Records",
      "description": "Running leaderboard across completed games.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "targets": [
        {
          "expr": "pichess_record_longest_game_moves",
          "legendFormat": "longest (moves)",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "pichess_record_shortest_game_moves",
          "legendFormat": "shortest (moves)",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "pichess_record_most_captures",
          "legendFormat": "most captures",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
