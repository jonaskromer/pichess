# Tier: lobbies — mvp + lobby-service, still in-memory.
# Use:  docker compose --env-file lobbies.env -f docker-compose.prod.yml up -d --remove-orphans
COMPOSE_PROFILES=lobbies

PICHESS_REGISTRY=ghcr.io/jonaskromer
PICHESS_IMAGE_TAG=0.3.1

# Wire the gateway to the lobby service (mirrors the lobbies overlay's gateway patch).
PICHESS_LOBBY_URL=http://lobby-service:8092
