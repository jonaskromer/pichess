# pichess developer defaults — assume dev environment.
#
# Read by:
#   • Make (via `-include .env` in the Makefile) — variables become the
#     fallback for any `?=` assignment and are inherited by every recipe
#     shell, so docker compose and sbt see them.
#   • docker compose — reads `.env` natively for ${VAR:-default}
#     interpolation in docker-compose.yml.
#
# Override anything here in `.env.local` (gitignored). Don't add secrets;
# this file is committed.

# Surfaces the /dev/* routes on the gateway and the Dev link on the
# start screen. Flip to false for a no-dev build.
PICHESS_DEV=true
