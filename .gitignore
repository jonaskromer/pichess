# macOS
.DS_Store

# sbt specific
dist/*
target/
lib_managed/
src_managed/
project/boot/
project/plugins/project/
project/local-plugins.sbt
.history
.ensime
.ensime_cache/
.sbt-scripted/
local.sbt

# Bloop
.bsp

# VS Code
.vscode/

# Metals
.bloop/
.metals/
.scala-build/
metals.sbt

# IDEA
.idea
.idea_modules
/.worksheet/

.scala-build/

/META-INF/
# Tailwind standalone CLI fetched by 'make tailwind-install'
/bin/

# Local output of scripts/gen-badges.sh — published as `metrics` pre-release assets, never committed
/badges/

# Dev stack selector state file (written by 'make stack-*')
/.pichess-stack

# Generated dev reports baked into gateway image
/gateway/src/main/resources/dev/coverage/report/*
!/gateway/src/main/resources/dev/coverage/report/.gitkeep
/gateway/src/main/resources/dev/performance/report/*
!/gateway/src/main/resources/dev/performance/report/.gitkeep

# Perf-suite output: JMH JSON, Gatling reports, k6 summaries, profile
# dumps. Big + per-run; never committed. Regenerated by `make perf-all`
# (or any sub-target). See docs/performance.md.
/perf-reports/

# Per-developer Make/compose env overrides (committed: .env)
/.env.local

# Claude Code session state — local scheduling locks, etc.
/.claude/
.venv-nnue/
nnue-train/__pycache__/

# large generated training data (never commit)
nnue-train/data/

# Ansible deploy artifacts — fetched kubeconfigs hold cluster creds; installed
# collections and retry files are local-only.
deploy/ansible/kubeconfig-*.yaml
deploy/ansible/collections/
*.retry
