# Tier: full — lobbies + repository + mongo + redis + kafka (durable + event log)
#   + analytics (spark-analytics + analytics-service, profile `full`) + prod-obs
#   (prometheus + grafana; NO jaeger — tracing is dev-only). Observe + analyze
#   tournament games with full persistence.
# Use:  docker compose --env-file full.env -f docker-compose.prod.yml up -d --remove-orphans
COMPOSE_PROFILES=full,prod-obs

PICHESS_REGISTRY=ghcr.io/jonaskromer
PICHESS_IMAGE_TAG=1.0.2

# Durable backend: mongo primary + redis cache, and the Kafka event log so
# game-service publishes chess.game-events and repository consumes them
# (mirrors the full overlay's merged ConfigMap).
PICHESS_BACKEND=mongo
PICHESS_CACHE=redis
PICHESS_KAFKA=kafka:9092
PICHESS_LOBBY_URL=http://lobby-service:8092

# Tournament: the NowChess server the bot plays on + the gateway spectates
# (edit per event). PICHESS_BOT_NAME must match across gateway + bot-tournament.
PICHESS_TOURNAMENT_URL=http://141.37.123.132:8086
PICHESS_BOT_CONTROL_URL=http://bot-tournament:8080
PICHESS_BOT_NAME=piChess

# Obs UI base URLs injected into the gateway-served SPA so the Analytics screen
# links resolve. Match the prod ingress (ingress-obs.yaml) nip.io hosts.
PICHESS_GRAFANA_URL=http://grafana.141.37.123.131.nip.io
PICHESS_PROMETHEUS_URL=http://prometheus.141.37.123.131.nip.io
