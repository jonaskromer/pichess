# Tier: mvp — gateway + game-service, in-memory (no datastore, no event log).
# Use:  docker compose --env-file mvp.env -f docker-compose.prod.yml up -d --remove-orphans
COMPOSE_PROFILES=mvp

# Released image coordinates (keep in sync with deploy/k8s + group_vars/all.yml).
PICHESS_REGISTRY=ghcr.io/jonaskromer
PICHESS_IMAGE_TAG=1.0.2

# Backend defaults to inmemory / no cache / no kafka / no lobby — nothing to set.
