{
  "uid": "pichess-analytics",
  "title": "piChess \u2014 game analytics",
  "tags": [
    "pichess",
    "analytics"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total games",
      "description": "Completed games seen (cumulative).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pichess_games_completed_total",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Active games",
      "description": "Games currently in progress (started, not yet ended).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "pichess_active_games",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Moves / sec",
      "description": "MoveMade events per second (1m rate).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(pichess_moves_total[1m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Games / min",
      "description": "GameStarted events per minute (5m rate).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(pichess_games_started_total[5m]))*60",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Move-event rates (per sec)",
      "description": "Per-second rates of each move classifier (1-minute window). Legend shows current + peak.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(pichess_moves_total[1m]))",
          "legendFormat": "moves",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_captures_total[1m]))",
          "legendFormat": "captures",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_checks_total[1m]))",
          "legendFormat": "checks",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_checkmates_total[1m]))",
          "legendFormat": "checkmates",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_promotions_total[1m]))",
          "legendFormat": "promotions",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_castles_total[1m]))",
          "legendFormat": "castles",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        },
        {
          "expr": "sum(rate(pichess_takebacks_total[1m]))",
          "legendFormat": "takebacks",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Game length & tempo",
      "description": "Avg/median/p90 game length (moves) and median think-time per move (from histograms).",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "pichess_completed_moves_total / clamp_min(pichess_games_completed_total,1)",
          "legendFormat": "avg moves/game",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (pichess_game_length_moves_bucket))",
          "legendFormat": "median length",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (pichess_game_length_moves_bucket))",
          "legendFormat": "p90 length",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (pichess_think_seconds_per_move_bucket))",
          "legendFormat": "median think (s)",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "table",
      "title": "Top openings (sequence \u2192 games, click to look up)",
      "description": "Most-played opening move-sequences. Bar = game count; click the move list to look it up.",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "topk(15, sum by (opening) (pichess_opening_games_total))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "stack": true
            },
            "renameByName": {
              "Value": "Games",
              "opening": "Opening (moves)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Games",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Games"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Opening (moves)"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Look up this opening",
                    "targetBlank": true,
                    "url": "https://www.google.com/search?q=chess+opening+${__value.text}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "barchart",
      "title": "Opening families (ECO)",
      "description": "Games grouped into ECO opening families (Sicilian, Ruy Lopez, \u2026).",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (family) (pichess_opening_family_total)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "stack": true
            },
            "renameByName": {
              "Value": "games"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "games",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "xField": "family",
        "barRadius": 0,
        "fullHighlight": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "barchart",
      "title": "Game outcomes",
      "description": "Result/end-reason per game: winning colour (resign), Draw, or a GameEnded status (Checkmate/Timeout/\u2026).",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (outcome) (pichess_games_by_outcome_total)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "stack": true
            },
            "renameByName": {
              "Value": "games"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "games",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "xField": "outcome",
        "barRadius": 0,
        "fullHighlight": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "barchart",
      "title": "First move",
      "description": "Distribution of opening first moves (e4 / d4 / Nf3 / \u2026).",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum by (move) (pichess_first_move_total)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "stack": true
            },
            "renameByName": {
              "Value": "games"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "games",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "xField": "move",
        "barRadius": 0,
        "fullHighlight": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Records",
      "description": "Running leaderboard across all completed games.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "targets": [
        {
          "expr": "pichess_record_longest_game_moves",
          "legendFormat": "longest game (moves)",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "pichess_record_shortest_game_moves",
          "legendFormat": "shortest game (moves)",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        },
        {
          "expr": "pichess_record_most_captures",
          "legendFormat": "most captures in a game",
          "refId": "A",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer-group lag",
      "description": "Unconsumed messages per consumer group. Near-zero = consumers (incl. Spark) keeping up.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka topic throughput (msg/s)",
      "description": "Messages produced per second per topic (1m rate).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      }
    }
  ]
}